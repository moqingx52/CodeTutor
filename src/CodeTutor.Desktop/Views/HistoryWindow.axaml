<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CodeTutor.Desktop.ViewModels"
        x:Class="CodeTutor.Desktop.Views.HistoryWindow"
        x:DataType="vm:HistoryWindowViewModel"
        Title="历史会话"
        Width="640" Height="480"
        WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto,Auto" Margin="12">
    <ListBox Grid.Row="0"
             ItemsSource="{Binding Sessions}"
             SelectedItem="{Binding SelectedSession}"
             DoubleTapped="OnItemDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Spacing="2" Margin="4">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap" Foreground="Gray" FontSize="12"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Margin="0,8,0,0" Foreground="Gray"/>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="刷新" Command="{Binding RefreshCommand}"/>
      <Button Content="加载" Click="OnLoadClick"/>
      <Button Content="删除" Command="{Binding DeleteCommand}"/>
      <Button Content="清空全部历史" Command="{Binding ClearAllCommand}"/>
      <Button Content="关闭" IsCancel="True" Click="OnCloseClick"/>
    </StackPanel>
  </Grid>
</Window>
